{
  "name": "whiteboard-scaffold",
  "version": "1.0.0",
  "description": "Scaffolded Whiteboard application with modular frontend",
  "main": "be/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "node be/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && node be/server.js"
  },
  "dependencies": {
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.2.11"
  }
}
